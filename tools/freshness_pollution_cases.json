{
 "schema": "ga.freshness_pollution_cases/v1",
 "note": "R511 task_freshness L2 污染信号端到端回放夹具；expect 为人工标注的 ground truth（语义来源=事件本体 vs 回声/引用）",
 "pattern_token": "站点故障",
 "_count_note": "files 内每个 .log 会被写进沙盒并扫描；expect.events/echoes 为期望的 signature_events/signature_echoes",
 "cases": [
  {
   "id": "c1_markdown_list",
   "kind": "polluted",
   "label": "markdown 列表/标题/引用行（回声）",
   "files": {
    "logs/a.log": "# 09-29 巡检报告\n- **L2 降级签名**：站点故障 命中 2 次\n> 引用原文：站点故障\n"
   },
   "target": {
    "id": "c1",
    "kind": "sche",
    "label": "replay c1",
    "cadence": "daily",
    "max_run_gap_days": 2,
    "run_evidence": [
     "done/*_c1.md"
    ],
    "scans": [
     {
      "globs": [
       "logs/*.log"
      ],
      "window_days": 3,
      "patterns": [
       "站点故障"
      ]
     }
    ]
   },
   "expect": {
    "alert": false,
    "events": 0,
    "echoes_min": 1,
    "why": "报告体排版行（标题/列表/引用）是回声，不是事件本体"
   }
  },
  {
   "id": "c2_code_fence",
   "kind": "polluted",
   "label": "fenced code block 内（回声）",
   "files": {
    "logs/a.log": "说明：\n```\n# 站点故障: HTTP 000\nreturn None\n```\n结束\n"
   },
   "target": {
    "id": "c2",
    "kind": "sche",
    "label": "replay c2",
    "cadence": "daily",
    "max_run_gap_days": 2,
    "run_evidence": [
     "done/*_c2.md"
    ],
    "scans": [
     {
      "globs": [
       "logs/*.log"
      ],
      "window_days": 3,
      "patterns": [
       "站点故障"
      ]
     }
    ]
   },
   "expect": {
    "alert": false,
    "events": 0,
    "echoes_min": 1,
    "why": "代码块内是引述/示例，不是运行期事件"
   }
  },
  {
   "id": "c3_quoted",
   "kind": "polluted",
   "label": "引号成对包裹（回声）",
   "files": {
    "logs/a.log": "报告里写着「站点故障」这一现象，属静默降级\n"
   },
   "target": {
    "id": "c3",
    "kind": "sche",
    "label": "replay c3",
    "cadence": "daily",
    "max_run_gap_days": 2,
    "run_evidence": [
     "done/*_c3.md"
    ],
    "scans": [
     {
      "globs": [
       "logs/*.log"
      ],
      "window_days": 3,
      "patterns": [
       "站点故障"
      ]
     }
    ]
   },
   "expect": {
    "alert": false,
    "events": 0,
    "echoes_min": 1,
    "why": "引号内是引述原话"
   }
  },
  {
   "id": "c4_indented_code",
   "kind": "polluted",
   "label": "缩进 ≥4 且代码特征（源码清单回声）",
