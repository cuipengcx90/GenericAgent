   }
  },
  {
   "id": "c6_traceback",
   "kind": "true_positive",
   "label": "traceback 块内（事件本体）",
   "files": {
    "logs/a.log": "Traceback (most recent call last):\n  File \"x.py\", line 3, in <module>\n    站点故障()\nRuntimeError: boom\n"
   },
   "target": {
    "id": "c6",
    "kind": "sche",
    "label": "replay c6",
    "cadence": "daily",
    "max_run_gap_days": 2,
    "run_evidence": [
