    "logs/a.log": "2026-09-29 09:00:00 ERROR 站点故障 rc=1\n"
   },
   "target": {
    "id": "c5",
    "kind": "sche",
    "label": "replay c5",
    "cadence": "daily",
    "max_run_gap_days": 2,
    "run_evidence": [
