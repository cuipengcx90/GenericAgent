    "logs/a.log": "def probe(self):\n    # 站点故障: 覆盖\n    self.x = 1\n    return 404\n"
   },
   "target": {
    "id": "c4",
    "kind": "sche",
    "label": "replay c4",
    "cadence": "daily",
    "max_run_gap_days": 2,
    "run_evidence": [
     "done/*_c4.md"
    ],
    "scans": [
     {
      "globs": [
       "logs/*.log"
      ],
      "window_days": 3,
      "patterns": [
       "站点故障"
      ]
     }
    ]
   },
   "expect": {
    "alert": false,
    "events": 0,
    "echoes_min": 1,
    "why": "缩进代码行=源码/清单回声"
   }
  },
  {
   "id": "c5_true_log",
   "kind": "true_positive",
   "label": "独立日志行（事件本体）",
