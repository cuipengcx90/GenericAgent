    ],
    "scans": [
     {
      "globs": [
       "logs/*.log"
      ],
      "window_days": 3,
      "patterns": [
       "站点故障"
      ]
     }
    ]
   },
   "expect": {
    "alert": true,
    "events_min": 1,
    "echoes": 0,
    "why": "异常栈内即使缩进也是事件本体"
   }
  },
  {
   "id": "c7_mixed",
   "kind": "mixed",
   "label": "同一文件既有回声又有事件（污染不得掩盖真信号）",
   "files": {
    "logs/a.log": "- 报告体：站点故障（回声）\n2026-09-29 09:00:00 ERROR 站点故障 rc=1\n"
   },
   "target": {
    "id": "c7",
    "kind": "sche",
    "label": "replay c7",
    "cadence": "daily",
    "max_run_gap_days": 2,
    "run_evidence": [
